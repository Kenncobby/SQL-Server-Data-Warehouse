{
  "name": "Sales Analytics",
  "dataColors": [
    "#2A9D8F",
    "#1F3A5F",
    "#6B9BC9",
    "#8FBFB5",
    "#C9A227",
    "#7A7A7A",
    "#4C7A73",
    "#3D5A80"
  ],
  "good": "#2E7D32",
  "bad": "#C62828",
  "neutral": "#C9A227",
  "background": "#FFFFFF",
  "foreground": "#1F3A5F",
  "tableAccent": "#2A9D8F",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#1F3A5F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F3A5F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#404040"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F3A5F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E4E8"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": "#1F3A5F",
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": "#404040",
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}