model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup Helpers

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["ServerName","DatabaseName","FiscalYearStartMonth","Dim Customer","Dim Product","Fact Sales","Dim Date","Refresh Info","_Measures"]

ref table 'Dim Customer'
ref table 'Dim Product'
ref table 'Fact Sales'
ref table 'Dim Date'
ref table 'Refresh Info'
ref table _Measures

ref cultureInfo en-US

